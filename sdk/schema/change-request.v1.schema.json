{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canter.dev/schema/change-request.v1.schema.json",
  "title": "Canter Change Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "canter.dev/v1alpha1"},
    "kind": {"const": "Change"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "summary", "verification"],
	  "oneOf": [
		{"required": ["release"], "not": {"required": ["scale"]}},
		{"required": ["scale"], "not": {"required": ["release"]}}
	  ],
      "properties": {
        "system": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
        "summary": {"type": "string", "minLength": 1},
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "command", "healthPath", "publicPort"],
          "properties": {
            "artifact": {"type": "string", "minLength": 1},
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "environment": {
              "type": "object",
              "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
              "additionalProperties": {"type": "string"}
            },
            "healthPath": {"type": "string", "pattern": "^/"},
            "publicPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "id", "service"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
            "service": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}
          }
        },
		"scale": {
		  "type": "object",
		  "additionalProperties": false,
		  "required": ["service", "replicas"],
		  "properties": {
			"service": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
			"replicas": {"type": "integer", "minimum": 1},
			"forSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}
		  }
		},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "expectedStatus"],
          "properties": {
            "method": {"const": "GET"},
            "path": {"type": "string", "pattern": "^/"},
            "expectedStatus": {"type": "integer", "minimum": 100, "maximum": 599},
            "bodyContains": {"type": "string"}
          }
        }
      }
    }
  }
}
