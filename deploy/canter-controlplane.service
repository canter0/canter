[Unit]
Description=Canter control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=canter
Group=canter
WorkingDirectory=/opt/canter
EnvironmentFile=/etc/canter/controlplane.env
ExecStart=/opt/canter/bin/canter-controlplane
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/canter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
