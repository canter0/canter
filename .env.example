# Canter loads this file from the working directory or its parents.
# Provider implementation names stay internal; public configuration uses compute and m1.
CANTER_ENV=development
OPENROUTER_API_KEY=
# Hosted workspace agent. The key stays in the control plane.
CANTER_OPERATOR_MODEL=anthropic/claude-sonnet-4.6
CANTER_OPERATOR_BASE_URL=https://openrouter.ai/api/v1
# scripts/dev.sh builds this trusted runtime for public static repository deploys.
CANTER_STATIC_SERVER_BINARY=./bin/canter-static-linux

# Local control plane
CANTER_DATABASE_URL=postgres://localhost:5432/canter?sslmode=disable
CANTER_CONTROLPLANE_ADDR=127.0.0.1:8081
CANTER_PUBLIC_URL=http://127.0.0.1:3000
CANTER_COOKIE_SECURE=false
CANTER_REQUIRE_INVITE=false
CANTER_BETA_INVITE=
# Register these exact callbacks using the same origin as CANTER_PUBLIC_URL:
# http://127.0.0.1:3000/api/canter/auth/oauth/google/callback
# http://127.0.0.1:3000/api/canter/auth/oauth/github/callback
CANTER_GOOGLE_CLIENT_ID=
CANTER_GOOGLE_CLIENT_SECRET=
CANTER_GITHUB_CLIENT_ID=
CANTER_GITHUB_CLIENT_SECRET=
CANTER_NODE_BINARY_PATH=./bin/canter-node-linux-amd64
# Public HTTPS origin used by tenant nodes. It must route /v1/node/* to this
# control-plane process; plain HTTP is rejected by the node client.
CANTER_NODE_GATEWAY_URL=

# m1 adapter
CANTER_M1_ENDPOINT=
CANTER_M1_BUCKET=
CANTER_M1_ACCESS_KEY=
CANTER_M1_SECRET_KEY=
CANTER_M1_REGION=auto

# compute adapter
CANTER_COMPUTE_AUTH_URL=
CANTER_COMPUTE_PROJECT=
CANTER_COMPUTE_PROJECT_DOMAIN=
CANTER_COMPUTE_USERNAME=
CANTER_COMPUTE_PASSWORD=
CANTER_COMPUTE_REGION=

# Billing is closed until Stripe and the reviewed rated-usage producer are ready.
# Run scripts/setup-billing.py with a test key; see docs/billing.md.
CANTER_BILLING_ENABLED=false
CANTER_STRIPE_SECRET_KEY=
CANTER_STRIPE_WEBHOOK_SECRET=
CANTER_STRIPE_PAYG_PRICE_ID=
CANTER_STRIPE_PRO_PRICE_ID=
CANTER_STRIPE_PRO_USAGE_PRICE_ID=
CANTER_STRIPE_METER_ID=
CANTER_STRIPE_METER_EVENT_NAME=canter_usage_cents_v1
CANTER_STRIPE_PORTAL_CONFIGURATION_ID=
# Random secret of at least 32 characters; never send to browsers or agents.
CANTER_BILLING_INGEST_TOKEN=
