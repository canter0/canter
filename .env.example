# Canter loads this file from the working directory or its parents.
# Provider implementation names stay internal; public configuration uses compute and m1.
CANTER_ENV=development
OPENROUTER_API_KEY=

# m1 adapter
CANTER_M1_ENDPOINT=
CANTER_M1_BUCKET=
CANTER_M1_ACCESS_KEY=
CANTER_M1_SECRET_KEY=
CANTER_M1_REGION=auto

# compute adapter
CANTER_COMPUTE_AUTH_URL=
CANTER_COMPUTE_PROJECT=
CANTER_COMPUTE_PROJECT_DOMAIN=
CANTER_COMPUTE_USERNAME=
CANTER_COMPUTE_PASSWORD=
CANTER_COMPUTE_REGION=
