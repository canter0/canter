# Canter loads this file from the working directory or its parents.
# Provider implementation names stay internal; public configuration uses compute and m1.
CANTER_ENV=development
OPENROUTER_API_KEY=

# Local control plane
CANTER_DATABASE_URL=postgres://localhost:5432/canter?sslmode=disable
CANTER_CONTROLPLANE_ADDR=127.0.0.1:8081
CANTER_PUBLIC_URL=http://localhost:3001
CANTER_COOKIE_SECURE=false
CANTER_REQUIRE_INVITE=false
CANTER_BETA_INVITE=
CANTER_NODE_BINARY_PATH=./bin/canter-node-linux-amd64
# Public HTTPS origin used by tenant nodes. It must route /v1/node/* to this
# control-plane process; plain HTTP is rejected by the node client.
CANTER_NODE_GATEWAY_URL=

# m1 adapter
CANTER_M1_ENDPOINT=
CANTER_M1_BUCKET=
CANTER_M1_ACCESS_KEY=
CANTER_M1_SECRET_KEY=
CANTER_M1_REGION=auto

# compute adapter
CANTER_COMPUTE_AUTH_URL=
CANTER_COMPUTE_PROJECT=
CANTER_COMPUTE_PROJECT_DOMAIN=
CANTER_COMPUTE_USERNAME=
CANTER_COMPUTE_PASSWORD=
CANTER_COMPUTE_REGION=
